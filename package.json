{
  "name": "argue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:pages",
    "build:app": "tsc -b && vite build",
    "build:cloudflare": "node --experimental-strip-types scripts/run-vite-build.ts cloudflare",
    "build:pages": "node --experimental-strip-types scripts/run-vite-build.ts pages",
    "build:server": "node --experimental-strip-types scripts/run-vite-build.ts local-server",
    "check:env": "node --experimental-strip-types scripts/validate-env.ts",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "npm run smoke:local && npm run smoke:browser && npm run smoke:remote",
    "smoke:browser": "node --experimental-strip-types scripts/smoke-browser.ts",
    "smoke:local": "node --experimental-strip-types scripts/smoke-local.ts",
    "smoke:remote": "node --experimental-strip-types scripts/smoke-remote.ts",
    "start": "node server/index.mjs",
    "test": "node --test --experimental-strip-types tests\\*.test.ts",
    "refresh:openrouter-stats": "node scripts/fetch-openrouter-stats.mjs"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "katex": "^0.16.35",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.7.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
