{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holy-union-290f",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-03-13",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://itjey.github.io,https://holy-union-290f.jeynarayan2010.workers.dev"
  }
}
