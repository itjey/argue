# Frontend defaults for GitHub Pages
VITE_PUBLIC_BASE=/argue/
VITE_OPENROUTER_AUTH_MODE=browser
VITE_OPENROUTER_API_BASE=
VITE_ALLOW_GUEST_MODE=false
VITE_BUSYTEX_BASE_PATH=

# Server or deployment surfaces
PORT=3000
OPENROUTER_API_KEY=
ALLOWED_ORIGINS=https://itjey.github.io,https://holy-union-290f.jeynarayan2010.workers.dev,http://localhost:3000,http://127.0.0.1:3000

# Surface notes
# - GitHub Pages uses build:pages and the defaults above.
# - Railway and local server builds should use build:server, which forces:
#     VITE_PUBLIC_BASE=/
#     VITE_OPENROUTER_AUTH_MODE=server
# - Cloudflare builds should use build:cloudflare, which forces:
#     VITE_PUBLIC_BASE=/
#     VITE_OPENROUTER_AUTH_MODE=server
#     VITE_ALLOW_GUEST_MODE=true
#     VITE_BUSYTEX_BASE_PATH=https://itjey.github.io/argue/core/busytex
